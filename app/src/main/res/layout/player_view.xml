<?xml version="1.0" encoding="utf-8"?>
<!--
  Imaginea playerului într-un TextureView: se desenează ca orice alt view, deci apare și sub straturile
  Compose (temă, tranziții). Un SurfaceView stă în spatele ferestrei și, pe unele televizoare, rămâne
  acoperit: se aude sunetul, dar imaginea e neagră.
-->
<androidx.media3.ui.PlayerView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:focusable="false"
    android:keepScreenOn="true"
    app:surface_type="texture_view"
    app:use_controller="false"
    app:show_buffering="never"
    app:resize_mode="fit"
    app:shutter_background_color="@android:color/black" />
