<?xml version="1.0" encoding="utf-8"?>
<!--
  Imaginea playerului într-un SurfaceView (setarea „Imagine fluidă”): decodorul scrie direct pe ecran,
  fără copia în plus a TextureView; mai fluid la 4K. Pe unele televizoare rămâne acoperit (ecran negru),
  de aceea e o setare, iar implicit rămâne player_view.xml (TextureView).
-->
<androidx.media3.ui.PlayerView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:focusable="false"
    android:keepScreenOn="true"
    app:surface_type="surface_view"
    app:use_controller="false"
    app:show_buffering="never"
    app:resize_mode="fit"
    app:shutter_background_color="@android:color/black" />
